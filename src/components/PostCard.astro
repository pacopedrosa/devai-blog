---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;

const words = (post.body ?? '').trim().split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 200));
---

<a class="post-card" href={`/blog/${post.id}/`}>
	<div class="media">
		{
			post.data.heroImage ? (
				<Image
					width={720}
					height={360}
					src={post.data.heroImage}
					alt=""
					transition:name={`post-image-${post.id}`}
				/>
			) : (
				<div class="media-fallback" aria-hidden="true">
					<span>&lt;/&gt;</span>
				</div>
			)
		}
	</div>
	<div class="body">
		<p class="meta">
			<FormattedDate date={post.data.pubDate} />
			<span aria-hidden="true">·</span>
			<span>{minutes} min de lectura</span>
		</p>
		<h3 class="title" transition:name={`post-title-${post.id}`}>{post.data.title}</h3>
		<p class="excerpt">{post.data.description}</p>
		<span class="more">Leer artículo →</span>
	</div>
</a>

<style>
	.post-card {
		display: flex;
		flex-direction: column;
		overflow: hidden;
		border: 1px solid var(--glass-border);
		border-radius: var(--radius-lg);
		background: var(--glass-bg);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		color: inherit;
		text-decoration: none;
		transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
	}
	.post-card:hover {
		transform: translateY(-4px);
		border-color: rgba(var(--accent-rgb), 0.45);
		box-shadow: var(--box-shadow);
	}
	.media {
		aspect-ratio: 2 / 1;
		/* Cards stretch to fill the grid row; without a cap, a lone wide card would
		   render a media block hundreds of pixels tall. */
		max-height: 240px;
		overflow: hidden;
	}
	.media :global(img) {
		width: 100%;
		height: 100%;
		border-radius: 0;
		object-fit: cover;
	}
	.media-fallback {
		display: grid;
		place-items: center;
		width: 100%;
		height: 100%;
		background:
			radial-gradient(circle at 25% 25%, rgba(var(--accent-rgb), 0.35), transparent 60%),
			linear-gradient(135deg, rgba(var(--accent-rgb), 0.18), rgba(6, 182, 212, 0.18));
		border-bottom: 1px solid var(--glass-border);
	}
	.media-fallback span {
		font-family: var(--font-mono);
		font-size: 2.4rem;
		font-weight: 700;
		color: rgb(var(--black));
		opacity: 0.7;
	}
	.body {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1.25rem 1.4rem 1.4rem;
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em;
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.74rem;
		color: rgb(var(--gray));
	}
	.title {
		margin: 0;
		font-size: 1.25rem;
		line-height: 1.25;
		color: rgb(var(--black));
	}
	.excerpt {
		margin: 0;
		max-width: 70ch;
		font-size: 0.95rem;
		line-height: 1.6;
		color: rgb(var(--gray));
	}
	.more {
		margin-top: auto;
		padding-top: 0.75rem;
		font-size: 0.9rem;
		font-weight: 700;
		color: var(--accent);
	}
	.post-card:hover .more {
		color: var(--accent-2);
	}
	@media (prefers-reduced-motion: reduce) {
		.post-card:hover {
			transform: none;
		}
	}
</style>
