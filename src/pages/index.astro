---
import { Code } from 'astro:components';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const snippet = `type Articulo = {
  tema: 'react' | 'nextjs' | 'astro' | 'typescript' | 'ia';
  probadoEnProduccion: boolean;
};

export function publicar(articulo: Articulo) {
  if (!articulo.probadoEnProduccion) {
    throw new Error('Aquí no se publica humo');
  }

  return deploy(articulo);
}`;
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={`${SITE_TITLE} · Desarrollo web moderno e IA aplicada`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="container hero-grid">
					<div class="hero-copy">
						<p class="eyebrow">desarrollo web · ia aplicada</p>
						<h1>
							Desarrollo web moderno,<br />
							<span class="gradient-text">potenciado por IA</span>
						</h1>
						<p class="hero-lead">
							Guías prácticas de <strong>React, Next.js, Astro y TypeScript</strong>, y cómo integrar
							herramientas de IA como Claude Code o GitHub Copilot en tu flujo de trabajo real. Lo que
							funciona, lo que no, y por qué — probado en proyectos de verdad.
						</p>
						<div class="actions">
							<a class="btn btn-primary" href="/blog">Empezar por aquí</a>
							<a class="btn btn-ghost" href="/sobre-mi">Sobre mí</a>
						</div>
						<ul class="chip-list hero-chips">
							<li class="chip">React</li>
							<li class="chip">Next.js</li>
							<li class="chip">Astro</li>
							<li class="chip">TypeScript</li>
							<li class="chip">Claude Code</li>
							<li class="chip">Copilot</li>
						</ul>
					</div>

					<div class="hero-visual">
						<div class="window">
							<div class="window-bar">
								<span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
								<span class="window-title">devai-blog.ts</span>
							</div>
							<Code code={snippet} lang="ts" theme="poimandres" />
						</div>
					</div>
				</div>
			</section>

			{
				posts.length > 0 && (
					<section class="section">
						<div class="container">
							<div class="section-head">
								<div>
									<p class="eyebrow">últimos artículos</p>
									<h2 class="section-title">Lo último que he publicado</h2>
								</div>
								<a class="link-arrow" href="/blog">
									Ver todos →
								</a>
							</div>
							<div class="posts-grid">
								{posts.map((post) => (
									<PostCard post={post} />
								))}
							</div>
						</div>
					</section>
				)
			}

			<section class="section">
				<div class="container">
					<p class="eyebrow">quién está detrás</p>
					<h2 class="section-title">Escrito por alguien que programa a diario</h2>

					<div class="bento">
						<article class="card bento-bio">
							<div class="identity">
								<span class="monogram" aria-hidden="true">PP</span>
								<div>
									<h3>Paco Pedrosa</h3>
									<p class="role">Software &amp; AI Engineer · Málaga</p>
								</div>
							</div>
							<p>
								Trabajo a diario con tecnologías web modernas y dedico buena parte de mi tiempo a
								integrar herramientas de inteligencia artificial en el flujo de trabajo de
								programación: asistentes de código, automatización de tareas repetitivas y nuevas
								formas de diseñar, revisar y desplegar software.
							</p>
							<a class="link-arrow" href="/sobre-mi">Más sobre mí →</a>
						</article>

						<article class="card bento-role">
							<p class="eyebrow">rol actual</p>
							<h3>De la investigación al producto</h3>
							<p>
								Trabajo en un grupo de investigación universitario especializado en IA aplicada, donde
								diseño y construyo plataformas de IA full-stack para agricultura digital y espacios de
								datos. Mi trabajo consiste en llevar modelos de machine learning desde el prototipo de
								investigación hasta sistemas en producción: frontends en Next.js, microservicios de ML
								en FastAPI y despliegue con Docker y CI/CD.
							</p>
						</article>

						<article class="card bento-stack">
							<h3>Stack que domino</h3>
							<ul class="chip-list">
								<li class="chip">React</li>
								<li class="chip">Next.js</li>
								<li class="chip">Astro</li>
								<li class="chip">TypeScript strict</li>
							</ul>
						</article>

						<article class="card bento-ai">
							<h3>IA en el día a día</h3>
							<ul class="chip-list">
								<li class="chip">Claude Code</li>
								<li class="chip">GitHub Copilot</li>
								<li class="chip">Automatización</li>
							</ul>
						</article>
					</div>
				</div>
			</section>

			<section class="section">
				<div class="container">
					<div class="card cta-band">
						<div>
							<h2 class="cta-title">¿Te ha resultado útil algo de lo que escribo?</h2>
							<p class="cta-text">
								Propón un tema, corrígeme un error o cuéntame qué estás montando. Leo todos los
								correos.
							</p>
						</div>
						<a class="btn btn-primary" href="/contacto">Escríbeme</a>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 100%;
		max-width: 100%;
		margin: 0;
		padding: 0;
	}
	.container {
		width: var(--wide-width);
		max-width: calc(100% - 2.5em);
		margin-inline: auto;
	}

	/* ---------- Hero ---------- */
	.hero {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		padding-block: clamp(2.5rem, 8vw, 5.5rem) clamp(2rem, 6vw, 4rem);
	}
	.hero::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background-image: radial-gradient(
			circle,
			rgba(var(--accent-rgb), 0.32) 1px,
			transparent 1.2px
		);
		background-size: 26px 26px;
		-webkit-mask-image: radial-gradient(ellipse 75% 65% at 50% 0%, #000 15%, transparent 75%);
		mask-image: radial-gradient(ellipse 75% 65% at 50% 0%, #000 15%, transparent 75%);
	}
	.hero::after {
		content: '';
		position: absolute;
		z-index: -2;
		inset: -25% -10% auto -10%;
		height: 80%;
		background:
			radial-gradient(circle at 22% 30%, rgba(124, 58, 237, 0.28), transparent 60%),
			radial-gradient(circle at 78% 20%, rgba(6, 182, 212, 0.2), transparent 60%);
		filter: blur(60px);
		animation: glow-drift 24s ease-in-out infinite alternate;
	}
	@keyframes glow-drift {
		0% {
			transform: translate3d(0, 0, 0) scale(1);
		}
		100% {
			transform: translate3d(3%, -2%, 0) scale(1.08);
		}
	}
	.hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
		gap: clamp(2rem, 5vw, 3.5rem);
		align-items: center;
	}
	/* Grid items default to min-width:auto, so the code block's longest line would
	   force the column wider than the viewport and get clipped by .hero's overflow. */
	.hero-grid > * {
		min-width: 0;
	}
	.hero h1 {
		margin: 0 0 1rem 0;
		font-size: clamp(2.3rem, 5.6vw, 3.6rem);
		line-height: 1.05;
		letter-spacing: -0.02em;
	}
	.hero-lead {
		max-width: 46ch;
		margin: 0 0 1.75rem 0;
		font-size: 1.05rem;
		line-height: 1.65;
		color: rgb(var(--gray));
	}
	.hero-lead strong {
		color: rgb(var(--gray-dark));
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-bottom: 1.75rem;
	}
	.hero-chips {
		gap: 0.4rem;
	}

	/* ---------- Terminal window ---------- */
	.window {
		border: 1px solid var(--glass-border);
		border-radius: var(--radius);
		background: #12151f;
		box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45), 0 0 0 1px rgba(var(--accent-rgb), 0.12);
		overflow: hidden;
	}
	.window-bar {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.65rem 0.9rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.07);
		background: rgba(255, 255, 255, 0.03);
	}
	.dots {
		display: flex;
		gap: 0.4rem;
	}
	.dots i {
		width: 0.7rem;
		height: 0.7rem;
		border-radius: 50%;
		background: #f87171;
	}
	.dots i:nth-child(2) {
		background: #fbbf24;
	}
	.dots i:nth-child(3) {
		background: #34d399;
	}
	.window-title {
		font-family: var(--font-mono);
		font-size: 0.74rem;
		color: #8b93a7;
	}
	/* Shiki sets its background inline; override it so the window chrome stays consistent. */
	.window :global(.astro-code) {
		margin: 0;
		padding: 1.25rem 1.35rem 1.5rem;
		border: 0;
		border-radius: 0;
		background: transparent !important;
		font-size: 0.8rem;
		line-height: 1.75;
		overflow-x: auto;
	}

	/* ---------- Sections ---------- */
	.section {
		padding-block: clamp(2.5rem, 7vw, 4.5rem);
	}
	.section-head {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		align-items: end;
		justify-content: space-between;
		margin-bottom: 2rem;
	}
	.section-head .section-title {
		margin: 0;
	}
	.link-arrow {
		font-weight: 700;
		font-size: 0.95rem;
		text-decoration: none;
	}
	.posts-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
		gap: 1.5rem;
	}

	/* ---------- Bento ---------- */
	.bento {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1.25rem;
	}
	.bento h3 {
		margin: 0 0 0.75rem 0;
		font-size: 1.15rem;
	}
	.bento p {
		margin: 0 0 1rem 0;
		font-size: 0.95rem;
		line-height: 1.65;
		color: rgb(var(--gray));
	}
	.bento-bio {
		grid-column: span 2;
		display: flex;
		flex-direction: column;
	}
	.bento-bio .link-arrow {
		margin-top: auto;
	}
	.identity {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 1.25rem;
	}
	.monogram {
		display: grid;
		place-items: center;
		width: 3.25rem;
		height: 3.25rem;
		border-radius: 50%;
		background: linear-gradient(135deg, var(--accent), var(--accent-2));
		color: #fff;
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 1.1rem;
	}
	.identity h3 {
		margin: 0;
		font-size: 1.3rem;
	}
	.role {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: var(--accent);
	}
	.bento-role {
		grid-column: span 2;
	}
	.bento-stack,
	.bento-ai {
		grid-column: span 2;
	}

	/* ---------- CTA ---------- */
	.cta-band {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
		align-items: center;
		justify-content: space-between;
		padding: clamp(1.75rem, 4vw, 2.5rem);
	}
	.cta-title {
		margin: 0 0 0.4rem 0;
		font-size: clamp(1.25rem, 2.6vw, 1.6rem);
	}
	.cta-text {
		margin: 0;
		max-width: 52ch;
		color: rgb(var(--gray));
		font-size: 0.98rem;
	}

	@media (max-width: 900px) {
		.hero-grid {
			grid-template-columns: minmax(0, 1fr);
		}
		.bento {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.bento-bio,
		.bento-role {
			grid-column: span 2;
			grid-row: auto;
		}
		.bento-stack,
		.bento-ai {
			grid-column: span 1;
		}
	}
	@media (max-width: 560px) {
		.bento {
			grid-template-columns: minmax(0, 1fr);
		}
		.bento-bio,
		.bento-role,
		.bento-stack,
		.bento-ai {
			grid-column: span 1;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.hero::after {
			animation: none;
		}
	}
</style>
